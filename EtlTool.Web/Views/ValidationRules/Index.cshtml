@model ValidationRulesViewModel
@using EtlTool.Domain.Enums

@{
    ViewData["Title"] = "Configure validations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Configure validations</h1>
        <p class="text-muted mb-0">Add validation rules for this pipeline.</p>
    </div>
    @if (Model.Rules.Count > 0)
    {
        <a class="btn btn-primary" asp-action="Create" asp-route-pipelineId="@Model.PipelineId">Add validation</a>
    }
</div>

@if (Model.Rules.Count == 0)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-3" role="status">
        <span>No validations have been configured.</span>
        <a class="btn btn-primary" asp-action="Create" asp-route-pipelineId="@Model.PipelineId">Add validation</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-3">
        @foreach (var rule in Model.Rules)
        {
            <div class="col">
                <article class="card h-100">
                    <div class="card-header"><h2 class="h5 mb-0">@Label(rule.Type)</h2></div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Target field</dt><dd class="col-sm-8 text-break">@rule.Field</dd>
                            @foreach (var item in rule.Configuration)
                            {
                                <dt class="col-sm-4">@item.Key</dt><dd class="col-sm-8 text-break">@item.Value</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(rule.ErrorMessage))
                            {
                                <dt class="col-sm-4">Error message</dt><dd class="col-sm-8 text-break">@rule.ErrorMessage</dd>
                            }
                        </dl>
                    </div>
                    <div class="card-footer">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Edit"
                           asp-route-pipelineId="@Model.PipelineId"
                           asp-route-ruleId="@rule.Id">Edit validation</a>
                    </div>
                </article>
            </div>
        }
    </div>
}

<div class="d-flex flex-wrap gap-2 mt-3">
    <a class="btn btn-outline-primary" asp-controller="Pipelines" asp-action="Preview" asp-route-id="@Model.PipelineId">Preview</a>
    <a class="btn btn-outline-secondary" asp-controller="Pipelines" asp-action="Edit" asp-route-id="@Model.PipelineId">Back to pipeline</a>
</div>

@functions {
    private static string Label(ValidationType type) => type switch
    {
        ValidationType.Required => "Required",
        ValidationType.EmailFormat => "Email format",
        ValidationType.NumericRange => "Numeric range",
        ValidationType.TextLengthRange => "Text length",
        ValidationType.DateRange => "Date range",
        ValidationType.UpsertKeyRequired => "Upsert key",
        _ => "Unsupported validation"
    };
}
