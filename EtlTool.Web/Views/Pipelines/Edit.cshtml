@model PipelineFormViewModel

@{
    ViewData["Title"] = "Edit pipeline";
    var pipelineId = ViewData["PipelineId"];
}

<h1>Edit pipeline</h1>
<p class="text-muted">Update the draft name and description.</p>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Edit" asp-route-id="@pipelineId" method="post">
            <partial name="_PipelineForm" model="Model" />
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-outline-primary" asp-action="Source" asp-route-id="@pipelineId">Configure source</a>
            <a class="btn btn-outline-primary" asp-action="Mapping" asp-route-id="@pipelineId">Configure fields</a>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
