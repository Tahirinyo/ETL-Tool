@model IReadOnlyList<PipelineListItemViewModel>

@{
    ViewData["Title"] = "Pipelines";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Pipelines</h1>
        <p class="text-muted mb-0">Create and manage reusable ETL pipeline drafts.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Create pipeline</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">
        No pipelines have been saved yet. Create a pipeline to get started.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Source type</th>
                    <th scope="col">Destination database</th>
                    <th scope="col">Destination collection</th>
                    <th scope="col">Updated</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pipeline in Model)
                {
                    <tr>
                        <td>@pipeline.Name</td>
                        <td>@pipeline.SourceTypeDisplay</td>
                        <td>@pipeline.DestinationDatabaseDisplay</td>
                        <td>@pipeline.DestinationCollectionDisplay</td>
                        <td>@pipeline.UpdatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="Edit"
                               asp-route-id="@pipeline.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger"
                               asp-action="Delete"
                               asp-route-id="@pipeline.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
