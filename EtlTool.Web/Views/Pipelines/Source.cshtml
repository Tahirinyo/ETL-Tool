@model SourceUploadViewModel

@{
    ViewData["Title"] = "Configure source";
    var pipelineId = Context.Request.RouteValues["id"];
}

<div class="mb-4">
    <h1 class="mb-1">Configure source</h1>
    <p class="text-muted mb-0">Choose a CSV, modern Excel workbook, PostgreSQL table, or MongoDB collection to configure its schema.</p>
</div>

<div class="row"><div class="col-lg-8">
    <form asp-action="InspectSource" asp-route-id="@pipelineId" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="SourceType" class="form-label">Source type</label>
            <select asp-for="SourceType" class="form-select" id="source-type">
                <option value="Csv">CSV</option>
                <option value="Xlsx">Excel (.xlsx)</option>
                <option value="PostgreSql">PostgreSQL</option>
                <option value="MongoDb">MongoDB</option>
            </select>
        </div>
        <div id="file-source-fields">
        <div class="mb-3">
            <label asp-for="SourceFile" class="form-label">Source file</label>
            <input asp-for="SourceFile" class="form-control" accept=".csv,.xlsx" />
            <span asp-validation-for="SourceFile" class="text-danger"></span>
        </div>
        <div class="mb-3" id="delimiter-group">
            <label asp-for="Delimiter" class="form-label">CSV delimiter</label>
            <select asp-for="Delimiter" class="form-select">
                <option value="Comma">Comma</option><option value="Semicolon">Semicolon</option><option value="Tab">Tab</option>
            </select>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">Upload and inspect</button>
        </div>
        </div>

        <div id="postgresql-source-fields">
            <input asp-for="LoadedPostgreSqlConnectionProfile" type="hidden" />
            <input asp-for="LoadedPostgreSqlDatabase" type="hidden" />
            <input asp-for="LoadedPostgreSqlSchema" type="hidden" />
            <div class="mb-3">
                <label asp-for="PostgreSqlConnectionProfile" class="form-label">Connection profile</label>
                <select asp-for="PostgreSqlConnectionProfile" class="form-select">
                    <option value="">Select a connection profile</option>
                    @foreach (var profile in Model.PostgreSqlConnectionProfiles) { <option value="@profile">@profile</option> }
                </select>
                <span asp-validation-for="PostgreSqlConnectionProfile" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PostgreSqlDatabase" class="form-label">Database</label>
                <select asp-for="PostgreSqlDatabase" class="form-select" disabled="@(Model.PostgreSqlDatabases.Count == 0)">
                    <option value="">Select a database</option>
                    @foreach (var database in Model.PostgreSqlDatabases) { <option value="@database">@database</option> }
                </select>
                <span asp-validation-for="PostgreSqlDatabase" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PostgreSqlSchema" class="form-label">Schema</label>
                <select asp-for="PostgreSqlSchema" class="form-select" disabled="@(Model.PostgreSqlSchemas.Count == 0)">
                    <option value="">Select a schema</option>
                    @foreach (var schema in Model.PostgreSqlSchemas) { <option value="@schema">@schema</option> }
                </select>
                <span asp-validation-for="PostgreSqlSchema" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PostgreSqlTable" class="form-label">Table</label>
                <select asp-for="PostgreSqlTable" class="form-select" disabled="@(Model.PostgreSqlTables.Count == 0)">
                    <option value="">Select a table</option>
                    @foreach (var table in Model.PostgreSqlTables) { <option value="@table">@table</option> }
                </select>
                <span asp-validation-for="PostgreSqlTable" class="text-danger"></span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-outline-primary" name="postgreSqlAction" value="refresh">Load options</button>
                <button type="submit" class="btn btn-primary" name="postgreSqlAction" value="configure">Inspect table and configure mapping</button>
            </div>
        </div>
        <div id="mongodb-source-fields">
            <input asp-for="LoadedMongoDbDatabase" type="hidden" />
            <div class="mb-3">
                <label class="form-label">Connection</label>
                <input class="form-control" value="Configured application MongoDB connection" readonly aria-describedby="mongodb-connection-help" />
                <div id="mongodb-connection-help" class="form-text">Connection credentials are supplied by application configuration and are not stored with this pipeline.</div>
            </div>
            <div class="mb-3">
                <label asp-for="MongoDbDatabase" class="form-label">Database</label>
                <select asp-for="MongoDbDatabase" class="form-select" disabled="@(Model.MongoDbDatabases.Count == 0)">
                    <option value="">Select a database</option>
                    @foreach (var database in Model.MongoDbDatabases) { <option value="@database">@database</option> }
                </select>
                <span asp-validation-for="MongoDbDatabase" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MongoDbCollection" class="form-label">Collection</label>
                <select asp-for="MongoDbCollection" class="form-select" disabled="@(Model.MongoDbCollections.Count == 0)">
                    <option value="">Select a collection</option>
                    @foreach (var collection in Model.MongoDbCollections) { <option value="@collection">@collection</option> }
                </select>
                <span asp-validation-for="MongoDbCollection" class="text-danger"></span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-outline-primary" name="mongoDbAction" value="refresh">Load options</button>
                <button type="submit" class="btn btn-primary" name="mongoDbAction" value="configure">Inspect collection and configure mapping</button>
            </div>
        </div>
        <div class="mt-3"><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@pipelineId">Back to pipeline</a></div>
    </form>

    @if (Model.StageId is not null && Model.WorksheetNames.Count > 0)
    {
        <hr />
        <form asp-action="SelectWorksheet" asp-route-id="@pipelineId" method="post">
            <input asp-for="StageId" type="hidden" />
            <div class="mb-3">
                <label asp-for="WorksheetName" class="form-label">Worksheet</label>
                <select asp-for="WorksheetName" class="form-select">
                    <option value="">Select a worksheet</option>
                    @foreach (var worksheet in Model.WorksheetNames) { <option value="@worksheet">@worksheet</option> }
                </select>
                <span asp-validation-for="WorksheetName" class="text-danger"></span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Read worksheet</button>
            </div>
        </form>
    }

    @if (Model.Columns.Count > 0)
    {
        <hr /><h2 class="h4">Detected columns</h2>
        <p>@string.Join(", ", Model.Columns)</p>
        <h2 class="h4">Sample rows</h2>
        <div class="table-responsive"><table class="table table-sm table-striped">
            <thead><tr><th>Row</th>@foreach (var column in Model.Columns) { <th>@column</th> }</tr></thead>
            <tbody>@foreach (var row in Model.SampleRows) { <tr><td>@row.SourceRowNumber</td>@foreach (var value in row.Values) { <td>@value</td> }</tr> }</tbody>
        </table></div>
        @if (Model.SampleRows.Count == 0) { <p class="text-muted">The source contains headers but no data rows.</p> }
        @if (Model.SchemaDifference is not null)
        {
            <div class="alert @(Model.SchemaDifference.RequiresRemapping ? "alert-warning" : "alert-info") mt-3" role="status">
                <h2 class="h5">Schema differences</h2>
                @if (Model.SchemaDifference.MissingFields.Count > 0)
                {
                    <p class="mb-1">Missing fields: @string.Join(", ", Model.SchemaDifference.MissingFields.Select(field => field.Name))</p>
                }
                @if (Model.SchemaDifference.NewFields.Count > 0)
                {
                    <p class="mb-1">New fields: @string.Join(", ", Model.SchemaDifference.NewFields.Select(field => field.Name))</p>
                }
                @if (Model.SchemaDifference.TypeChanges.Count > 0)
                {
                    <p class="mb-1">Type suggestions changed: @string.Join(", ", Model.SchemaDifference.TypeChanges.Select(change => $"{change.FieldName} ({change.SavedType} to {change.InspectedType})"))</p>
                }
                @if (Model.SchemaDifference.UnresolvedMappings.Count > 0)
                {
                    <p class="mb-2">Mappings needing repair: @string.Join(", ", Model.SchemaDifference.UnresolvedMappings.Select(mapping => $"{mapping.SourceField} to {mapping.TargetField}"))</p>
                }
                @if (Model.SchemaDifference.RequiresRemapping && Model.PendingSourceReferenceId is Guid pendingSourceReferenceId)
                {
                    <a class="btn btn-warning" asp-action="Mapping" asp-route-id="@pipelineId" asp-route-pendingSourceReferenceId="@pendingSourceReferenceId">Review and confirm schema</a>
                }
            </div>
        }
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a class="btn btn-outline-primary" asp-action="Mapping" asp-route-id="@pipelineId">Configure fields</a>
        </div>
    }
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const type = document.getElementById('source-type');
        const delimiter = document.getElementById('delimiter-group');
        const fileFields = document.getElementById('file-source-fields');
        const postgreSqlFields = document.getElementById('postgresql-source-fields');
        const mongoDbFields = document.getElementById('mongodb-source-fields');
        const sync = () => {
            const isPostgreSql = type.value === 'PostgreSql';
            const isMongoDb = type.value === 'MongoDb';
            const isDatabaseSource = isPostgreSql || isMongoDb;
            fileFields.hidden = isDatabaseSource;
            postgreSqlFields.hidden = !isPostgreSql;
            mongoDbFields.hidden = !isMongoDb;
            delimiter.hidden = type.value !== 'Csv';
            fileFields.querySelectorAll('input, select, button').forEach(element => element.disabled = isDatabaseSource);
            postgreSqlFields.querySelectorAll('input, button').forEach(element => element.disabled = !isPostgreSql);
            postgreSqlFields.querySelectorAll('select').forEach(element =>
                element.disabled = !isPostgreSql || element.options.length <= 1);
            mongoDbFields.querySelectorAll('input, button').forEach(element => element.disabled = !isMongoDb);
            mongoDbFields.querySelectorAll('select').forEach(element =>
                element.disabled = !isMongoDb || element.options.length <= 1);
        };
        type.addEventListener('change', sync); sync();
    </script>
}
