@model PipelinePreviewViewModel

@{
    ViewData["Title"] = "Preview pipeline";
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="mb-1">Preview pipeline</h1>
        <p class="text-muted mb-0">@Model.PipelineName — first 100 source rows</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.PipelineId">Back to pipeline</a>
        <a class="btn btn-outline-primary" asp-action="Source" asp-route-id="@Model.PipelineId">Configure source</a>
    </div>
</div>

@if (Model.ReadinessProblems.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <h2 class="h5">The pipeline is not ready for preview.</h2>
        <ul class="mb-0">
            @foreach (var problem in Model.ReadinessProblems)
            {
                <li><strong>@problem.Component:</strong> @problem.Message</li>
            }
        </ul>
    </div>
}
else if (Model.FailureMessage is not null)
{
    <div class="alert alert-danger" role="alert">
        @Model.FailureMessage
    </div>

    @if (Model.RequiresSourceUpload)
    {
        <a class="btn btn-primary" asp-action="Source" asp-route-id="@Model.PipelineId">Upload source again</a>
    }
}
else if (Model.HasPreview)
{
    <form asp-action="Execute" asp-route-id="@Model.PipelineId" method="post" class="mb-4">
        <button type="submit" class="btn btn-success">Execute pipeline</button>
    </form>

    <div class="row g-3 mb-4" aria-label="Preview counters">
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body"><div class="text-muted">Valid</div><div class="fs-3">@Model.ValidRowCount</div></div></div>
        </div>
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body"><div class="text-muted">Invalid</div><div class="fs-3">@Model.InvalidRowCount</div></div></div>
        </div>
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body"><div class="text-muted">Filtered</div><div class="fs-3">@Model.FilteredRowCount</div></div></div>
        </div>
    </div>

    <section class="mb-4">
        <h2 class="h4">Transformed rows</h2>
        <partial name="_PreviewTable" model="Model.Table!" />
    </section>

    <section>
        <h2 class="h4">Row errors</h2>
        <partial name="_PreviewErrors" model="Model.Errors!" />
    </section>
}
