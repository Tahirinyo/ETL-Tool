@model TransformationRulesViewModel

@{
    ViewData["Title"] = "Configure transformations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Configure transformations</h1>
        <p class="text-muted mb-0">Add, edit, or remove transformations for this pipeline.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create" asp-route-pipelineId="@Model.PipelineId">Add transformation</a>
</div>

@if (Model.Rules.Count == 0)
{
    <div class="alert alert-info" role="status">No transformations have been configured.</div>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Order</th><th>Type</th><th>Field</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var rule in Model.Rules)
        {
            <tr>
                <td>@rule.Order</td>
                <td>@rule.Type</td>
                <td>@rule.SourceField</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-pipelineId="@Model.PipelineId" asp-route-ruleId="@rule.Id">Edit</a>
                    <form class="d-inline" asp-action="Delete" asp-route-pipelineId="@Model.PipelineId" asp-route-ruleId="@rule.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<a class="btn btn-outline-secondary" asp-controller="Pipelines" asp-action="Edit" asp-route-id="@Model.PipelineId">Back to pipeline</a>
