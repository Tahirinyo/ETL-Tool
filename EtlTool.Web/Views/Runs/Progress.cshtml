@model EtlTool.Web.Models.Runs.RunProgressViewModel

@{
    ViewData["Title"] = "Run progress";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Run progress</h1>
        <p class="text-muted mb-0">This page refreshes automatically while the run is active.</p>
    </div>
</div>

<div id="polling-error" class="alert alert-warning d-none" role="alert" aria-live="assertive"></div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9" data-run-field="status">Loading…</dd>
            <dt class="col-sm-3">Started</dt>
            <dd class="col-sm-9" data-run-field="startedAt">Loading…</dd>
            <dt class="col-sm-3">Completed</dt>
            <dd class="col-sm-9" data-run-field="completedAt">Loading…</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5">Row progress</h2>
        <p class="mb-2" data-run-field="rowProgress">Loading…</p>
        <div class="progress" data-run-field="progressIndicator" role="progressbar" aria-label="Row progress" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" data-run-field="progressBar" style="width: 0%"></div>
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 g-3">
    <div class="col"><div class="card"><div class="card-body"><div class="text-muted" data-run-field="totalRowsLabel">Total rows</div><div class="fs-4" data-run-field="totalRows">Loading…</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body"><div class="text-muted">Processed rows</div><div class="fs-4" data-run-field="processedRows">Loading…</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body"><div class="text-muted">Valid rows</div><div class="fs-4" data-run-field="validRows">Loading…</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body"><div class="text-muted">Invalid rows</div><div class="fs-4" data-run-field="invalidRows">Loading…</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body"><div class="text-muted">Filtered rows</div><div class="fs-4" data-run-field="filteredRows">Loading…</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body"><div class="text-muted">Deduplicated rows</div><div class="fs-4" data-run-field="deduplicatedRows">Loading…</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body"><div class="text-muted">Inserted rows</div><div class="fs-4" data-run-field="insertedRows">Loading…</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body"><div class="text-muted">Updated rows</div><div class="fs-4" data-run-field="updatedRows">Loading…</div></div></div></div>
</div>

@section Scripts {
    <script>
        (() => {
            const statusUrl = '/Runs/@Model.RunId/Status';
            const pollingIntervalMilliseconds = 2000;
            const terminalStatuses = new Set(['Completed', 'PartiallyCompleted', 'Failed', 'Interrupted']);
            const fields = Object.fromEntries(
                [...document.querySelectorAll('[data-run-field]')]
                    .map((element) => [element.dataset.runField, element]));
            const error = document.getElementById('polling-error');
            let isPolling = true;
            let nextPoll;

            const formatTimestamp = (value, unavailableText) => value
                ? new Date(value).toLocaleString()
                : unavailableText;

            const showError = (message) => {
                error.textContent = message;
                error.classList.remove('d-none');
            };

            const clearError = () => {
                error.textContent = '';
                error.classList.add('d-none');
            };

            const stopPolling = () => {
                isPolling = false;
                window.clearTimeout(nextPoll);
            };

            const updateProgress = (run) => {
                fields.status.textContent = run.status;
                fields.startedAt.textContent = formatTimestamp(run.startedAt, 'Not started');
                fields.completedAt.textContent = formatTimestamp(run.completedAt, 'Not completed');

                for (const field of ['processedRows', 'validRows', 'invalidRows', 'filteredRows', 'deduplicatedRows', 'insertedRows', 'updatedRows']) {
                    fields[field].textContent = run[field];
                }

                const isSuccessfullyCompleted = run.status === 'Completed';
                const isActive = !terminalStatuses.has(run.status);

                if (isSuccessfullyCompleted) {
                    fields.totalRowsLabel.textContent = 'Total rows';
                    fields.totalRows.textContent = run.totalRows;
                } else if (isActive) {
                    fields.totalRowsLabel.textContent = 'Source total';
                    fields.totalRows.textContent = 'Unknown while processing';
                } else {
                    fields.totalRowsLabel.textContent = 'Rows observed';
                    fields.totalRows.textContent = run.totalRows;
                }

                fields.progressBar.classList.remove('progress-bar-striped', 'progress-bar-animated');
                fields.progressIndicator.removeAttribute('aria-valuenow');

                if (isSuccessfullyCompleted && run.totalRows > 0) {
                    const percentage = Math.max(0, Math.min(100, (run.processedRows / run.totalRows) * 100));
                    fields.rowProgress.textContent = `${run.processedRows} / ${run.totalRows} rows (${percentage.toFixed(0)}%)`;
                    fields.progressBar.style.width = `${percentage}%`;
                    fields.progressBar.textContent = `${percentage.toFixed(0)}%`;
                    fields.progressIndicator.setAttribute('aria-valuenow', percentage.toFixed(0));
                    fields.progressIndicator.setAttribute('aria-valuetext', `${percentage.toFixed(0)}% complete`);
                } else if (isSuccessfullyCompleted) {
                    fields.rowProgress.textContent = '0 rows processed. Completed.';
                    fields.progressBar.style.width = '0%';
                    fields.progressBar.textContent = '';
                    fields.progressIndicator.setAttribute('aria-valuetext', 'Completed with no source rows.');
                } else if (isActive) {
                    fields.rowProgress.textContent = `${run.processedRows} rows processed. Processing source…`;
                    fields.progressBar.classList.add('progress-bar-striped', 'progress-bar-animated');
                    fields.progressBar.style.width = '100%';
                    fields.progressBar.textContent = '';
                    fields.progressIndicator.setAttribute('aria-valuetext', 'Processing source. Total row count is not yet known.');
                } else {
                    fields.rowProgress.textContent = `${run.processedRows} rows processed. Run ended before the source total was known.`;
                    fields.progressBar.style.width = '0%';
                    fields.progressBar.textContent = '';
                    fields.progressIndicator.setAttribute('aria-valuetext', 'Run ended before the source total was known.');
                }
            };

            const scheduleNextPoll = () => {
                if (isPolling) nextPoll = window.setTimeout(poll, pollingIntervalMilliseconds);
            };

            const poll = async () => {
                try {
                    const response = await fetch(statusUrl, { headers: { Accept: 'application/json' } });
                    if (response.status === 404) {
                        showError('This run was not found or is no longer available.');
                        stopPolling();
                        return;
                    }

                    if (!response.ok) throw new Error(`Status request failed with ${response.status}.`);

                    const run = await response.json();
                    updateProgress(run);
                    clearError();
                    if (terminalStatuses.has(run.status)) stopPolling();
                } catch {
                    showError('Progress could not be refreshed. Retrying shortly.');
                } finally {
                    scheduleNextPoll();
                }
            };

            poll();
        })();
    </script>
}
