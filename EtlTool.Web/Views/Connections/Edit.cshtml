@model EditSavedConnectionViewModel

@{ ViewData["Title"] = "Edit connection"; }

<h1>Edit connection</h1>
<p class="text-muted">@Model.ProviderDisplay connection · active revision @Model.ActiveRevision</p>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Database type</label><input class="form-control" value="@Model.ProviderDisplay" readonly /></div>
    <div class="mb-3">
        <label asp-for="ConnectionConfiguration" class="form-label"></label>
        <input asp-for="ConnectionConfiguration" type="password" class="form-control" autocomplete="new-password" value="" />
        <div class="form-text">Leave blank to keep the current protected configuration.</div>
        <span asp-validation-for="ConnectionConfiguration" class="text-danger"></span>
    </div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Save changes</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
