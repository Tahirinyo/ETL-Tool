@model IReadOnlyList<SavedConnectionListItemViewModel>

@{ ViewData["Title"] = "Connections"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h1 class="mb-1">Connections</h1><p class="text-muted mb-0">Manage reusable MongoDB and PostgreSQL connections.</p></div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Create" asp-route-providerType="MongoDb">Add MongoDB</a>
        <a class="btn btn-primary" asp-action="Create" asp-route-providerType="PostgreSql">Add PostgreSQL</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">No saved connections have been created yet.</div>
}
else
{
    <div class="table-responsive"><table class="table table-striped align-middle">
        <thead><tr><th>Name</th><th>Type</th><th>Revision</th><th>Updated</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var connection in Model)
        {
            <tr>
                <td>@connection.Name</td><td>@connection.ProviderDisplay</td><td>@connection.ActiveRevision</td>
                <td>@connection.UpdatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@connection.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@connection.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table></div>
}
