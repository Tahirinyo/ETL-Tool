@model CreateSavedConnectionViewModel
@using EtlTool.Domain.Enums

@{ ViewData["Title"] = "Add connection"; }

<h1>Add connection</h1>
<p class="text-muted">The connection string is protected before it is persisted.</p>
<form asp-action="Create" method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3">
        <label asp-for="ProviderType" class="form-label"></label>
        <select asp-for="ProviderType" class="form-select"><option value="@DatabaseProviderType.MongoDb">MongoDB</option><option value="@DatabaseProviderType.PostgreSql">PostgreSQL</option></select>
        <span asp-validation-for="ProviderType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConnectionConfiguration" class="form-label"></label>
        <input asp-for="ConnectionConfiguration" type="password" class="form-control" autocomplete="new-password" value="" />
        <div class="form-text">The value is write-only and will not be shown again.</div>
        <span asp-validation-for="ConnectionConfiguration" class="text-danger"></span>
    </div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Save connection</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
