{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDb": {
    "MetadataDatabaseName": "etl_tool_metadata",
    "BulkWriteMaximumAttempts": 2,
    "BulkWriteRetryDelayMilliseconds": 200,
    "SourceExecutionFetchSize": 1000
  },
  "PostgreSql": {
    "BatchWriteMaximumAttempts": 2,
    "BatchWriteRetryDelayMilliseconds": 200
  },
  "UploadStorage": {
    "RootPath": "App_Data/uploads"
  },
  "ErrorReportStorage": {
    "RootPath": "App_Data/error-reports"
  },
  "UploadValidation": {
    "MaxFileSizeBytes": 104857600,
    "MaxDataRowCount": 100000
  },
  "EtlExecution": {
    "BatchSize": 1000
  },
  "BackgroundJobQueue": {
    "Capacity": 100
  },
  "RunAdmission": {
    "QueueAdmissionTimeoutMilliseconds": 5000
  },
  "AllowedHosts": "*"
}
