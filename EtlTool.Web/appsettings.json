{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDb": {
    "MetadataDatabaseName": "etl_tool_metadata"
  },
  "UploadStorage": {
    "RootPath": "App_Data/uploads"
  },
  "UploadValidation": {
    "MaxFileSizeBytes": 104857600,
    "MaxDataRowCount": 100000
  },
  "EtlExecution": {
    "BatchSize": 1000
  },
  "AllowedHosts": "*"
}
