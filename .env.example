# Use values local to your development machine. Do not commit the copied .env file.
MONGO_INITDB_ROOT_USERNAME=<local-mongo-admin-username>
MONGO_INITDB_ROOT_PASSWORD=<local-mongo-admin-password>

# Use the Compose service hostname "mongo" and authenticate against "admin".
# URI-encode reserved characters in the username and password.
MONGODB_CONNECTION_STRING=mongodb://<URI-encoded-username>:<URI-encoded-password>@mongo:27017/?authSource=admin
